<configure
        xmlns="http://namespaces.zope.org/zope"
        xmlns:browser="http://namespaces.zope.org/browser"
        i18n_domain="interaktiv.translation">

    <!-- Controlpanel Volto Frontend -->
    <adapter
            factory=".translation.TranslationControlpanel"
            name="translation"
    />

    <!-- The API key never goes to the browser -->
    <adapter factory=".api_key.ApiKeySerializer"/>
    <adapter factory=".api_key.ApiKeyDeserializer"/>

    <!-- Controlpanel Backend -->
    <browser:page
            name="translation-controlpanel"
            for="Products.CMFPlone.interfaces.IPloneSiteRoot"
            class=".classic.TranslationSettingsControlPanel"
            permission="cmf.ManagePortal"
            layer="interaktiv.translation.interfaces.IInteraktivTranslationBrowserLayer"
    />

</configure>
