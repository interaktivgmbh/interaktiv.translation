<configure
        xmlns="http://namespaces.zope.org/zope"
        xmlns:plone="http://namespaces.plone.org/plone">

    <include package="plone.rest" file="meta.zcml"/>

    <!-- the links of the content as it is now, for an editor to go through -->
    <plone:service
            method="GET"
            factory=".get.TranslationLinksGet"
            for="plone.dexterity.interfaces.IDexterityContent"
            permission="cmf.ModifyPortalContent"
            name="@translation-links"
            layer="interaktiv.translation.interfaces.IInteraktivTranslationBrowserLayer"
    />

</configure>
