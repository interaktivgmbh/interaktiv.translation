<?xml version="1.0"?>
<object name="portal_actions" meta_type="Plone Actions Tool"
        xmlns:i18n="http://xml.zope.org/namespaces/i18n"
        i18n:domain="interaktiv.translation">
    <object name="object_buttons" meta_type="CMF Action Category">
        <object name="translate" meta_type="CMF Action" i18n:attributes="title">
            <property name="title">Translate</property>
            <property name="description"/>
            <property name="url_expr">string:${object_url}/@@translate-content</property>
            <property name="icon_expr">string:language</property>
            <property name="available_expr">python:object.restrictedTraverse('@@translation-available')()</property>
            <property name="permissions">
                <element value="plone.app.multilingual: Manage Translations"/>
            </property>
            <property name="visible">True</property>
        </object>
    </object>
</object>
